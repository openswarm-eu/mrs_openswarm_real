<launch>

  <!-- args corresponding to environment variables -->
  <arg name="UAV_NAME" default="$(optenv UAV_NAME)" />

  <group ns="$(arg UAV_NAME)">
    <node name="uav_fsm" pkg="mrs_openswarm_utils" type="fsm_uav.py" output="screen">
      <param name="uav_name" value="$(arg UAV_NAME)" />
      <!-- <param name="uav_names" type="yaml" value="[uav6, uav7, uav8, uav9, uav10, uav11, uav12, uav13, uav14]"/> -->
      <param name="uav_names" type="yaml" value="[uav12, uav13]"/>
    </node>
  </group>

</launch>