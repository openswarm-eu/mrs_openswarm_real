<launch>

    <arg name="UAV_NAME" default="$(optenv UAV_NAME)"/>
    <arg name="ROS_CONFIG_PATH" default="$(optenv ROS_CONFIG_PATH)" />

    <group ns="$(arg UAV_NAME)">
        <node pkg="mrs_openswarm_utils" type="pose_generator.py" name="pose_generator" output="screen">
            <rosparam file="$(arg ROS_CONFIG_PATH)/swarm/pose_generator.yaml" command="load"/>
            <param name="yaml_file" value="$(arg ROS_CONFIG_PATH)/swarm/target_poses.yaml" />
        </node>
    </group>
</launch>