<launch>

    <arg name="UAV_NAME" default="$(optenv UAV_NAME)"/>
    <arg name="ROS_CONFIG_PATH" default="$(optenv ROS_CONFIG_PATH)" />

    <group ns="$(arg UAV_NAME)">
        <node pkg="mrs_openswarm_utils" type="switch_estimator.py" name="switch_estimator" output="screen">
            <rosparam file="$(arg ROS_CONFIG_PATH)/switch_estimator.yaml" command="load" />
        </node>
    </group>

</launch>