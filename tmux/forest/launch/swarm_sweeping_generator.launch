<launch>

  <!-- args corresponding to environment variables -->
  <arg name="UAV_NAME" default="$(optenv UAV_NAME)" />
  <arg name="UAV_NAMES" default="$(optenv UAV_NAMES)" />
  <arg name="COMPUTER_NAME" default="$(optenv COMPUTER_NAME)" />
  <arg name="ROS_CONFIG_PATH" default="$(optenv ROS_CONFIG_PATH)" />

    <!-- Namespace - all topics, services and parameters will be remapped using this namespace as a prefix (eg.: "/waypoint_flier_simple/odom_uav_in" to "/uav1/waypoint_flier_simple/odom_uav_in") -->
  <group ns="$(arg UAV_NAME)">

    <node pkg="sweeping_generator" type="swarm_sweeping_latlon.py" name="sweeping_generator" output="screen">

      <!-- ROS parameters config file -->
      <rosparam file="$(arg ROS_CONFIG_PATH)/sweeping_generator.yaml" command="load" />

      <param name="uav_name" value="$(arg UAV_NAME)" />
      <param name="uav_names" type="yaml" value="$(arg UAV_NAMES)"/>
      <param name="computer_name" value="$(arg COMPUTER_NAME)" />

     <!-- Define the waypoint list as a parameter -->
      <!-- <param name="waypoint_list" type="yaml" value="[
          [10.0, 15.0, 1.5],
          [10.0, 30.0, 1.5],
          [20.0, 30.0, 1.5]
      ]"/> -->

     <!-- Define the waypoint list as a parameter -->
     <!-- <param name="waypoint_frame" value="utm_navsat" />
      <param name="waypoint_list" type="yaml" value="[
          [41.22096739828961, -8.527199651250513, 4.0],
          [41.221082140231395, -8.527172723731946, 4.0]
      ]"/> -->

     <!-- Define the waypoint list as a parameter -->
     <!-- <param name="waypoint_frame" value="utm_navsat" />
      <param name="waypoint_list" type="yaml" value="[
          [41.2209532565427, -8.527199874661083, 3.0],
          [41.2211558739817, -8.527162951815466, 3.0]
      ]"/> -->

     <!-- Define the waypoint list as a parameter Forest -->
     <!-- <param name="waypoint_frame" value="utm_navsat" />
      <param name="waypoint_list" type="yaml" value="[
          [41.216771, -8.527210, 3.0]
      ]"/> -->

     <!-- Define the waypoint list as a parameter Forest -->
     <param name="waypoint_frame" value="utm_navsat" />
      <param name="waypoint_list" type="yaml" value="[
          [41.2169393, -8.5272475, 6.0],
          [41.2167611, -8.5269573, 6.0],
          [41.216761, -8.5271551, 6.0],
          [41.2168936, -8.5272511, 2.5],
          [41.2165874, -8.5274389, 7.0]
      ]"/>

    <!-- Home: latitude: 47.3975176, longitude: 8.5453274 -->
    <!-- Origin: latitude: 47.3977466, longitude: 8.5455947 -->
    <!-- 2nd Point: latitude: 47.3975202, longitude: 8.5455976 -->

    <!-- Simulation -->

    <!-- <param name="waypoint_list" type="yaml" value="[
        [47.3977442, 8.5457252, 1.5],
        [47.3977896, 8.5457231, 1.5],
        [47.3978347, 8.5457256, 1.5],
        [47.3978803, 8.5457928, 1.5],
        [47.3979254, 8.5458589, 1.5],
        [47.3979258, 8.5459256, 1.5],
        [47.3979259, 8.5459925, 1.5],
        [47.3979264, 8.5460594, 1.5],
        [47.3978362, 8.5460602, 1.5],
        [47.3977455, 8.5460610, 1.5],
        [47.3976553, 8.5460618, 1.5],
        [47.3976539, 8.5457272, 1.5],
        [47.3976992, 8.5457268, 1.5]
    ]"/> -->

    <!-- latitude: 47.3977442 longitude: 8.5457252 (10.0, 0.0) -->
