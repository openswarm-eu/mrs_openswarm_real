    <!-- latitude: 47.3978362 longitude: 8.5460602 (35.0, 10.0) -->
    <!-- latitude: 47.3977455 longitude: 8.5460610 (35.0, 0.0) -->
    <!-- latitude: 47.3976553 longitude: 8.5460618 (35.0, -10.0) -->
    <!-- latitude: 47.3976539 longitude: 8.5457272 (10.0, -10.0) -->
    <!-- latitude: 47.3976992 longitude: 8.5457268 (10.0, -5.0) -->

      <remap from="~control_manager_diag_in" to="control_manager/diagnostics" />
      <remap from="~octomap_planner_diag_in" to="octomap_planner/diagnostics" />
      <remap from="~path_out" to="trajectory_generation/path" />
      <remap from="~start_in" to="~start" />

    </node>

  </group>

</launch>
