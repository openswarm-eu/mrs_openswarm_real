<launch>

  <!-- args corresponding to environment variables -->
  <arg name="UAV_NAME" default="$(optenv UAV_NAME)" />

  <group ns="$(arg UAV_NAME)">
    <node name="repub_odom_tf_desired" pkg="mrs_openswarm_utils" type="repub_odom_tf_desired" output="screen">
      <param name="uav_name" value="$(arg UAV_NAME)" />
      <param name="target_frame" value="$(arg UAV_NAME)/fcu" />
      <param name="parent_frame" value="$(arg UAV_NAME)/odom" />
      <!-- <remap from="odom" to="lio_sam/imupreintegration/odom" /> -->
      <remap from="odom" to="lio_sam/mapping/odometry" />
    </node>
  </group>

</launch>