<launch>

    <!-- args corresponding to environment variables -->
    <arg name="UAV_NAME" default="$(optenv UAV_NAME)" />
    <arg name="UAV_NAMES" default="$(optenv UAV_NAMES)" />
    <arg name="COMPUTER_NAME" default="$(optenv COMPUTER_NAME)" />
    <arg name="ROS_CONFIG_PATH" default="$(optenv ROS_CONFIG_PATH)" />

    <arg name="rviz" default="false" />

    <group ns="$(arg UAV_NAME)">
      <rosparam file="$(arg ROS_CONFIG_PATH)/leishen_cal.yaml" command="load" /> 

      <param name="point_filter_num" type="int" value="3"/>
      <param name="max_iteration" type="int" value="5" />
      <param name="cube_side_length" type="double" value="1000" />

      <rosparam param="common/lid_topic" subst_value="true"> /$(arg UAV_NAME)/lslidar/pcl_filtered</rosparam>
      <rosparam param="common/imu_topic" subst_value="true"> /$(arg UAV_NAME)/hw_api/imu</rosparam>
      <rosparam param="common/baselinkFrame" subst_value="true"> $(arg UAV_NAME)/fcu</rosparam>
      <rosparam param="common/odometryFrame" subst_value="true"> $(arg UAV_NAME)/odom</rosparam>

      <rosparam param="initialization/use_calibration_file" subst_value="true" > true</rosparam>

      <node pkg="lidar_imu_init" type="li_init" name="laserMapping" output="screen">
        <remap from="/cloud_registered" to="cloud_registered" />
        <remap from="/cloud_registered_body" to="cloud_registered_body" />
        <remap from="/cloud_effected" to="cloud_effected" />
        <remap from="/Laser_map" to="Laser_map" />
        <remap from="/aft_mapped_to_init" to="Odometry" />
        <remap from="/path" to="path" />
        <remap from="/global_map" to="global_map" />
      </node>

    </group>

      <group if="$(arg rviz)">
      <node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz" args="-d $(find lidar_imu_init)/rviz_cfg/spinning.rviz" />
      </group>
    launch-prefix="gdb -ex run --args" 
</launch>
